extends Node3D
## Main scene of the vertical slice: class selection -> player spawn -> floor -> boss -> summary.
## Level geometry and encounters are generated by tools/gen_level.py into Main.tscn.

const PLAYER_SCENE: PackedScene = preload("res://player/Player.tscn")

@onready var _level: LevelNavigation = $Level
@onready var _camera_rig: CameraRig = $CameraRig
@onready var _hud: Hud = $HUD
@onready var _debug_tools: DebugTools = $DebugTools
@onready var _start: Marker3D = $PlayerStart

var _player: Node3D
var _elapsed: float = 0.0
var _running: bool = false
var _finished: bool = false
var _kills: int = 0
var _total_enemies: int = 0
var _chests_opened: int = 0
var _total_chests: int = 0


func _ready() -> void:
	InputSetup.ensure()
	CombatLog.clear()
	_count_objectives()
	if not _level.nav_ready:
		await _level.navigation_ready
	if GameSession.selected_class == null:
		var menu: ClassSelect = ClassSelect.new()
		add_child(menu)
		GameSession.selected_class = await menu.class_chosen
		menu.queue_free()
	_spawn_player(GameSession.selected_class)


func _process(delta: float) -> void:
	if _running and not _finished:
		_elapsed += delta


func _spawn_player(class_data: ClassData) -> void:
	var player: Player = PLAYER_SCENE.instantiate() as Player
	player.class_data = class_data  # BEFORE entering the tree: components read it in _ready()
	player.position = _start.position
	add_child(player)
	_player = player
	_camera_rig.target = player
	_camera_rig.global_position = player.global_position
	_camera_rig.reset_physics_interpolation()
	_debug_tools.targeting = player.get_node("TargetingController") as TargetingController
	_hud.setup(player)
	(player.get_node("PlayerController") as PlayerController).input_enabled = true
	(player.get_node("HealthComponent") as HealthComponent).died.connect(_on_player_died)
	_running = true
	CombatLog.add("Playing as %s" % class_data.display_name)


func _count_objectives() -> void:
	for enemy in get_tree().get_nodes_in_group("enemies"):
		_total_enemies += 1
		var health: HealthComponent = enemy.get_node_or_null("HealthComponent") as HealthComponent
		if health != null:
			health.died.connect(_on_enemy_died.bind(enemy))
	for chest in get_tree().get_nodes_in_group("chests"):
		_total_chests += 1
		(chest as LootChest).opened.connect(_on_chest_opened)


func _on_enemy_died(_result: AttackResult, enemy: Node) -> void:
	_kills += 1
	if enemy.is_in_group("boss"):
		_finish()


func _on_chest_opened() -> void:
	_chests_opened += 1


func _on_player_died(_result: AttackResult) -> void:
	_running = false


func _finish() -> void:
	if _finished:
		return
	_finished = true
	var minutes: int = int(_elapsed) / 60
	var seconds: int = int(_elapsed) % 60
	_hud.show_summary("%s\n\n%s %02d:%02d\n%s %d / %d\n%s %d / %d\n\n%s" % [
		tr("FLOOR CLEARED"), tr("Time"), minutes, seconds,
		tr("Enemies defeated"), _kills, _total_enemies,
		tr("Caches opened"), _chests_opened, _total_chests,
		tr("R: play again    F2: change class")])
	CombatLog.add("Floor cleared in %02d:%02d" % [minutes, seconds])
