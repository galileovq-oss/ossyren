[resource]
script = ExtResource("1_cd")
id = &"vanguard"
display_name = "Vanguard"
description = "Frontline bruiser. High health and armour, low mana. Wins by standing its ground."
kit_summary = "Set I: Breaching Maul \n Set II: Combat Blade\nPassive: Iron Will (+armour, +DR)\n1 Bulwark (barrier) \n 2 Ground Pound (melee area)"
stats = ExtResource("3_stats")
weapon_set_1 = ExtResource("4_w1")
weapon_set_2 = ExtResource("5_w2")
abilities = Array[ExtResource("2_ad")]([ExtResource("a0"), ExtResource("a1")])
passives = Array[ExtResource("2_ad")]([ExtResource("p0")])
